#!/usr/bin/env python3
"""生成10张基底图的"缺陷类型对比表"（UP浓/DOWN适中）"""
import sys
sys.path.insert(0, '.')
from generate_synthetic_defects import imread_unicode, imwrite_unicode, add_scratch, add_stains, add_spots, add_missing_region, add_texture_noise, generate_defect
import numpy as np
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont

# === 中文字体 ===
def get_font(size=20):
    candidates = [
        '/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc',
        '/mnt/c/Windows/Fonts/msyh.ttc',
        '/mnt/c/Windows/Fonts/simhei.ttf',
    ]
    for p in candidates:
        if Path(p).exists():
            try:
                return ImageFont.truetype(p, size)
            except:
                pass
    return ImageFont.load_default()

font_title = get_font(22)
font_label = get_font(16)

# === UP视图用浓参数，DOWN视图用适中参数 ===
DOWN_PARAMS = {}  # 用函数默认值（适中）

UP_PARAMS = {
    'scratch': {'max_scratches': 2, 'min_width': 1, 'max_width': 3, 'min_opacity': 0.35, 'max_opacity': 0.6},
    'stains': {'max_stains': 3, 'min_size': 10, 'max_size': 40, 'min_opacity': 0.25, 'max_opacity': 0.45},
    'spots': {'max_spots': 10, 'spot_size': 3, 'opacity_range': (0.3, 0.55)},
    'missing': {'max_regions': 1, 'min_ratio': 0.05, 'max_ratio': 0.15},
}

def make_defect_table(img_bgr, output_path, is_up=False):
    """生成一张缺陷对比表（2行x3列）"""
    h, w = img_bgr.shape[:2]
    params = UP_PARAMS if is_up else DOWN_PARAMS
    
    # 使用params或默认
    def apply_with(fn, name):
        p = params.get(name, {})
        return fn(img_bgr.copy(), **p) if p else fn(img_bgr.copy())
    
    variants = [
        ('原图', img_bgr),
        ('划痕', apply_with(add_scratch, 'scratch')),
        ('污渍', apply_with(add_stains, 'stains')),
        ('斑点', apply_with(add_spots, 'spots')),
        ('缺失区域', apply_with(add_missing_region, 'missing')),
        ('组合缺陷', generate_defect(img_bgr.copy())),
    ]
    
    cell_w = w + 20
    cell_h = h + 40
    cols, rows = 3, 2
    
    canvas_w = cell_w * cols + 10
    canvas_h = cell_h * rows + 50
    canvas = Image.new('RGB', (canvas_w, canvas_h), 'white')
    draw = ImageDraw.Draw(canvas)
    
    view_tag = "UP(浓)" if is_up else "DOWN(适中)"
    for idx, (name, img_bgr) in enumerate(variants):
        col = idx % cols
        row = idx // cols
        x = 10 + col * cell_w
        y = 50 + row * cell_h
        draw.text((x + w//2 - len(name)*8, y + 5), name, fill='black', font=font_label)
        img_rgb = img_bgr[..., ::-1]
        pil_img = Image.fromarray(img_rgb)
        canvas.paste(pil_img, (x + 10, y + 30))
    
    draw.text((10, 5), f'缺陷类型对比 [{view_tag}]', fill='black', font=font_title)
    canvas.save(output_path, quality=95)


def detect_view(filename):
    """从文件名检测UP/DOWN"""
    stem = Path(filename).stem
    if '_UP' in stem or stem.endswith('UP'):
        return 'UP'
    return 'DOWN'


# === MAIN ===
out_dir = Path('experiment_data/visualization/synthetic_table')
out_dir.mkdir(parents=True, exist_ok=True)

all_good = []
for cat_dir in sorted(Path('data/晶圆分类数据集').iterdir()):
    if not cat_dir.is_dir():
        continue
    good_dir = cat_dir / 'test' / 'good'
    if good_dir.exists():
        for f in sorted(good_dir.glob('*')):
            # 尽量平衡UP/DOWN
            if detect_view(f.name) == 'UP' and len([x for x in all_good if detect_view(x.name) == 'UP']) >= 5:
                continue
            if detect_view(f.name) == 'DOWN' and len([x for x in all_good if detect_view(x.name) == 'DOWN']) >= 5:
                continue
            all_good.append(f)
            if len(all_good) >= 10:
                break
    if len(all_good) >= 10:
        break

all_good = all_good[:10]
print(f"Base images: {len(all_good)}")
up_count = sum(1 for f in all_good if detect_view(f.name) == 'UP')
down_count = sum(1 for f in all_good if detect_view(f.name) == 'DOWN')
print(f"  UP={up_count}, DOWN={down_count}")

for idx, img_path in enumerate(all_good):
    img = imread_unicode(str(img_path))
    if img is None:
        print(f"  [{idx}] FAIL: {img_path.name}")
        continue
    is_up = detect_view(img_path.name) == 'UP'
    out_name = f"defect_table_{idx:02d}_{'UP_' if is_up else 'DOWN_'}{img_path.stem}.jpg"
    out_path = out_dir / out_name
    make_defect_table(img, str(out_path), is_up=is_up)
    tag = "UP(浓)" if is_up else "DOWN(适中)"
    print(f"  [{idx}] {tag} {img_path.stem}")

print(f"\nDone! {len(all_good)} tables saved to {out_dir}")
